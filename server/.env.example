# Secret de signature des sessions (≥ 32 caractères aléatoires) : openssl rand -base64 48
AUTH_SECRET=
PORT=8787
DB_PATH=/var/lib/kinesyp/kinesyp.db
# URL publique de l'application web (retour après paiement) et origines autorisées (CORS)
APP_URL=https://app.kinesyp.fr
CORS_ORIGINS=https://app.kinesyp.fr
NODE_ENV=production

# Stripe (Dashboard → Développeurs → Clés API ; produit "KinéSyP" à 50 €/mois → ID du prix)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PRICE_ID=price_...
# Dashboard → Webhooks → endpoint https://api.kinesyp.fr/stripe/webhook
# Événements : checkout.session.completed, customer.subscription.created/updated/deleted
STRIPE_WEBHOOK_SECRET=whsec_...

# Pour tester en local sans Stripe (paiement simulé) : BILLING_MODE=simulation
