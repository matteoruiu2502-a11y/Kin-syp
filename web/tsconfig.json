{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": { "@core": ["../mobile/src/core/index.ts"], "@core/*": ["../mobile/src/core/*"] }
  },
  "include": ["src", "../mobile/src/core"],
  "exclude": ["../mobile/src/core/__tests__"]
}
